{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@server/*": ["./server/*"]
    }
  },
  "include": [
    "server/**/*.ts",
    "api/**/*.ts",
    "scripts/**/*.ts",
    "drizzle.config.ts"
  ]
}
